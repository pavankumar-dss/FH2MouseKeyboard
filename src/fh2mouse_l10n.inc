     "msgstr \"WS \320\264\320\273\321\217 \320\265\320\267\320\264\321\213, \321\201\321\202\321\200\320\265\320\273\320\272\320\270 \320\264\320\273\321\217 \321\200\321\203\320\273\321\217\"\n"
     "\n"
     "msgid \"Arrow drive\"\n"
     "msgstr \"\320\225\320\267\320\264\320\260 \320\275\320\260 \321\201\321\202\321\200\320\265\320\273\320\272\320\260\321\205\"\n"
     "\n"
     "msgid \"Custom\"\n"
     "msgstr \"\320\241\320\262\320\276\320\271\"\n"
     "\n"
     "msgid \"FH2 ANNA's key while driving, pressing the controller's d-pad for it. The open key is ANNA's whenever you drive, the others only while ANNA's menu is open: a driving key on the same key waits till then.\"\n"
     "msgstr \"\320\232\320\273\320\260\320\262\320\270\321\210\320\260 FH2 ANNA \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213; \320\275\320\260\320\266\320\270\320\274\320\260\320\265\321\202 \320\267\320\260 \320\275\320\265\321\221 \320\272\321\200\320\265\321\201\321\202\320\276\320\262\320\270\320\275\321\203 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200\320\260. \320\232\320\273\320\260\320\262\320\270\321\210\320\260 \320\276\321\202\320\272\321\200\321\213\321\202\320\270\321\217 \320\277\321\200\320\270\320\275\320\260\320\264\320\273\320\265\320\266\320\270\321\202 ANNA \320\262\321\201\320\265\320\263\320\264\320\260, \320\277\320\276\320\272\320\260 \320\262\321\213 \320\265\320\264\320\265\321\202\320\265, \320\276\321\201\321\202\320\260\320\273\321\214\320\275\321\213\320\265 \321\202\320\276\320\273\321\214\320\272\320\276 \320\277\321\200\320\270 \320\276\321\202\320\272\321\200\321\213\321\202\320\276\320\274 \320\274\320\265\320\275\321\216 ANNA: \320\264\320\265\320\271\321\201\321\202\320\262\320\270\320\265 \320\265\320\267\320\264\321\213 \320\275\320\260 \321\202\320\276\320\271 \320\266\320\265 \320\272\320\273\320\260\320\262\320\270\321\210\320\265 \320\262 \321\215\321\202\320\276 \320\262\321\200\320\265\320\274\321\217 \320\275\320\265 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202.\"\n"
     "\n"
     "msgid \"ANNA Drone Mode's key while flying the drone. While it flies only its keys (and the radio's) count, so it can be a driving or menu key too.\"\n"
     "msgstr \"\320\232\320\273\320\260\320\262\320\270\321\210\320\260 ANNA Drone Mode \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\277\320\276\320\273\321\221\321\202\320\260 \320\264\321\200\320\276\320\275\320\260. \320\237\320\276\320\272\320\260 \320\276\320\275 \320\273\320\265\321\202\320\260\320\265\321\202, \321\200\320\260\320\261\320\276\321\202\320\260\321\216\321\202 \321\202\320\276\320\273\321\214\320\272\320\276 \320\265\320\263\320\276 \320\272\320\273\320\260\320\262\320\270\321\210\320\270 (\320\270 \320\272\320\273\320\260\320\262\320\270\321\210\320\270 \321\200\320\260\320\264\320\270\320\276), \320\277\320\276\321\215\321\202\320\276\320\274\321\203 \320\276\320\275\320\260 \320\274\320\276\320\266\320\265\321\202 \321\201\320\276\320\262\320\277\320\260\320\264\320\260\321\202\321\214 \321\201 \320\272\320\273\320\260\320\262\320\270\321\210\320\265\320\271 \320\265\320\267\320\264\321\213 \320\270\320\273\320\270 \320\274\320\265\320\275\321\216.\"\n"
     "\n"
     "msgid \"The key for this in the menus. It does nothing while driving, so it can be a driving key too.\"\n"
     "msgstr \"\320\232\320\273\320\260\320\262\320\270\321\210\320\260 \320\264\320\273\321\217 \321\215\321\202\320\276\320\263\320\276 \320\262 \320\274\320\265\320\275\321\216. \320\222\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213 \320\276\320\275\320\260 \320\275\320\270\321\207\320\265\320\263\320\276 \320\275\320\265 \320\264\320\265\320\273\320\260\320\265\321\202, \320\277\320\276\321\215\321\202\320\276\320\274\321\203 \320\274\320\276\320\266\320\265\321\202 \320\261\321\213\321\202\321\214 \320\270 \320\272\320\273\320\260\320\262\320\270\321\210\320\265\320\271 \320\265\320\267\320\264\321\213.\"\n"
     "\n"
     "msgid \"The key for this while driving: Extra Options' own, pressed on the controller button its ini gives it. It does nothing in the menus, so it can be a menu key too.\"\n"
     "msgstr \"\320\232\320\273\320\260\320\262\320\270\321\210\320\260 \320\264\320\273\321\217 \321\215\321\202\320\276\320\263\320\276 \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213: \321\201\320\276\320\261\321\201\321\202\320\262\320\265\320\275\320\275\320\260\321\217 \321\204\321\203\320\275\320\272\321\206\320\270\321\217 Extra Options, \320\275\320\260\320\266\320\270\320\274\320\260\321\216\321\211\320\260\321\217 \320\272\320\275\320\276\320\277\320\272\321\203 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200\320\260, \320\267\320\260\320\264\320\260\320\275\320\275\321\203\321\216 \320\262 \320\265\321\221 ini. \320\222 \320\274\320\265\320\275\321\216 \320\276\320\275\320\260 \320\275\320\270\321\207\320\265\320\263\320\276 \320\275\320\265 \320\264\320\265\320\273\320\260\320\265\321\202, \320\277\320\276\321\215\321\202\320\276\320\274\321\203 \320\274\320\276\320\266\320\265\321\202 \320\261\321\213\321\202\321\214 \320\270 \320\272\320\273\320\260\320\262\320\270\321\210\320\265\320\271 \320\274\320\265\320\275\321\216.\"\n"
     "\n"
