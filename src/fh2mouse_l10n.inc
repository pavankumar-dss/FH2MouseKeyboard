    {"ko",
     "msgid \"KEYBOARD & MOUSE\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234\354\231\200 \353\247\210\354\232\260\354\212\244\"\n"
     "\n"
     "msgctxt \"mod.description\"\n"
     "msgid \"Drive with the keyboard, point at things in the menus and click them, drag the map, turn the garage camera, place decals with the keyboard, and fly the photo mode camera, all without picking up a controller.\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234\353\241\234 \354\232\264\354\240\204\355\225\230\352\263\240, \353\251\224\353\211\264\353\245\274 \352\260\200\353\246\254\354\274\234 \355\201\264\353\246\255\355\225\230\352\263\240, \354\247\200\353\217\204\353\245\274 \353\223\234\353\236\230\352\267\270\355\225\230\352\263\240, \354\260\250\352\263\240 \354\271\264\353\251\224\353\235\274\353\245\274 \353\217\214\353\246\254\352\263\240, \355\202\244\353\263\264\353\223\234\353\241\234 \353\215\260\354\271\274\354\235\204 \353\260\260\354\271\230\355\225\230\352\263\240, \354\202\254\354\247\204 \353\252\250\353\223\234 \354\271\264\353\251\224\353\235\274\353\245\274 \354\241\260\354\242\205\355\225\230\354\204\270\354\232\224. \353\252\250\353\221\220 \354\273\250\355\212\270\353\241\244\353\237\254 \354\227\206\354\235\264 \352\260\200\353\212\245\355\225\251\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"Keyboard controls\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234 \354\241\260\354\236\221\"\n"
     "\n"
     "msgid \"Drive with the keyboard and move around the menus with it. The rows below set the keys.\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234\353\241\234 \354\232\264\354\240\204\355\225\230\352\263\240 \353\251\224\353\211\264\353\245\274 \354\235\264\353\217\231\355\225\251\353\213\210\353\213\244. \354\225\204\353\236\230 \355\225\255\353\252\251\354\227\220\354\204\234 \355\202\244\353\245\274 \354\204\244\354\240\225\355\225\251\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"Keyboard icons\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234 \354\225\204\354\235\264\354\275\230\"\n"
     "\n"
     "msgid \"While you play with the keyboard, the help bar shows its keys instead of the controller's buttons. A button on the controller brings the buttons back.\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234\353\241\234 \355\224\214\353\240\210\354\235\264\355\225\230\353\212\224 \353\217\231\354\225\210 \353\217\204\354\233\200\353\247\220 \355\221\234\354\213\234\354\244\204\354\227\220 \354\273\250\355\212\270\353\241\244\353\237\254 \353\262\204\355\212\274 \353\214\200\354\213\240 \355\202\244\353\245\274 \355\221\234\354\213\234\355\225\251\353\213\210\353\213\244. \354\273\250\355\212\270\353\241\244\353\237\254 \353\262\204\355\212\274\354\235\204 \353\210\204\353\245\264\353\251\264 \353\213\244\354\213\234 \353\262\204\355\212\274\354\235\264 \355\221\234\354\213\234\353\220\251\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"Mouse hover selects\"\n"
     "msgstr \"\353\247\210\354\232\260\354\212\244\353\245\274 \354\230\254\353\246\254\353\251\264 \354\204\240\355\203\235\"\n"
     "\n"
     "msgid \"Moving the mouse over a button, list row or slider selects it. Off, only a click does.\"\n"
     "msgstr \"\353\262\204\355\212\274, \353\252\251\353\241\235 \355\226\211, \354\212\254\353\235\274\354\235\264\353\215\224 \354\234\204\353\241\234 \353\247\210\354\232\260\354\212\244\353\245\274 \352\260\200\354\240\270\352\260\200\353\251\264 \354\204\240\355\203\235\353\220\251\353\213\210\353\213\244. \353\201\204\353\251\264 \355\201\264\353\246\255\355\225\264\354\225\274\353\247\214 \354\204\240\355\203\235\353\220\251\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"Mouse free look\"\n"
     "msgstr \"\353\247\210\354\232\260\354\212\244 \354\236\220\354\234\240 \354\213\234\354\240\220\"\n"
     "\n"
     "msgid \"While driving, moving the mouse looks around. The cursor stays in the game's window: Alt+Tab to leave it.\"\n"
     "msgstr \"\354\232\264\354\240\204 \354\244\221 \353\247\210\354\232\260\354\212\244\353\245\274 \354\233\200\354\247\201\354\235\264\353\251\264 \354\243\274\354\234\204\353\245\274 \353\221\230\353\237\254\353\264\205\353\213\210\353\213\244. \354\273\244\354\204\234\353\212\224 \352\262\214\354\236\204 \354\260\275 \354\225\210\354\227\220 \353\250\270\353\254\264\353\245\264\353\251\260, \353\262\227\354\226\264\353\202\230\353\240\244\353\251\264 Alt+Tab\354\235\204 \353\210\204\353\245\264\354\204\270\354\232\224.\"\n"
     "\n"
     "msgid \"Mouse free look sensitivity\"\n"
     "msgstr \"\353\247\210\354\232\260\354\212\244 \354\236\220\354\234\240 \354\213\234\354\240\220 \352\260\220\353\217\204\"\n"
     "\n"
     "msgid \"How far the camera turns for the mouse's movement while you look around. 50 is the usual, 100 twice as far, 0 not at all.\"\n"
     "msgstr \"\354\243\274\354\234\204\353\245\274 \353\221\230\353\237\254\353\263\274 \353\225\214 \353\247\210\354\232\260\354\212\244 \354\233\200\354\247\201\354\236\204\354\227\220 \353\224\260\353\235\274 \354\271\264\353\251\224\353\235\274\352\260\200 \353\217\204\353\212\224 \354\240\225\353\217\204\354\236\205\353\213\210\353\213\244. 50\354\235\264 \352\270\260\353\263\270, 100\354\235\200 \353\221\220 \353\260\260, 0\354\235\200 \353\217\214\354\247\200 \354\225\212\354\212\265\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"Keyboard preset\"\n"
     "msgstr \"\355\202\244\353\263\264\353\223\234 \355\224\204\353\246\254\354\205\213\"\n"
     "\n"
     "msgid \"Sets every key below at once. WS drive, arrow steer is the mod's own layout; AZERTY and QWERTZ put the keys where WASD's are on those keyboards. Changing a key makes it Custom.\"\n"
