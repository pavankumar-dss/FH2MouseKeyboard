     "\n"
     "msgid \"While you play with the keyboard, the help bar shows its keys instead of the controller's buttons. A button on the controller brings the buttons back.\"\n"
     "msgstr \"\320\237\320\276\320\272\320\260 \320\262\321\213 \320\270\320\263\321\200\320\260\320\265\321\202\320\265 \320\275\320\260 \320\272\320\273\320\260\320\262\320\270\320\260\321\202\321\203\321\200\320\265, \320\277\320\260\320\275\320\265\320\273\321\214 \320\277\320\276\320\264\321\201\320\272\320\260\320\267\320\276\320\272 \320\277\320\276\320\272\320\260\320\267\321\213\320\262\320\260\320\265\321\202 \320\265\321\221 \320\272\320\273\320\260\320\262\320\270\321\210\320\270 \320\262\320\274\320\265\321\201\321\202\320\276 \320\272\320\275\320\276\320\277\320\276\320\272 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200\320\260. \320\235\320\260\320\266\320\260\321\202\320\270\320\265 \320\272\320\275\320\276\320\277\320\272\320\270 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200\320\260 \320\262\320\276\320\267\320\262\321\200\320\260\321\211\320\260\320\265\321\202 \320\272\320\275\320\276\320\277\320\272\320\270.\"\n"
     "\n"
