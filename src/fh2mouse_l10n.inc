     "msgstr \"\351\215\265\347\233\244\345\234\226\347\244\272\"\n"
     "\n"
     "msgid \"While you play with the keyboard, the help bar shows its keys instead of the controller's buttons. A button on the controller brings the buttons back.\"\n"
     "msgstr \"\347\224\250\351\215\265\347\233\244\351\201\212\347\216\251\346\231\202\357\274\214\350\252\252\346\230\216\345\210\227\346\234\203\351\241\257\347\244\272\346\214\211\351\215\265\350\200\214\351\235\236\346\216\247\345\210\266\345\231\250\346\214\211\351\210\225\343\200\202\346\214\211\344\270\213\346\216\247\345\210\266\345\231\250\346\214\211\351\210\225\345\215\263\346\201\242\345\276\251\351\241\257\347\244\272\346\214\211\351\210\225\343\200\202\"\n"
