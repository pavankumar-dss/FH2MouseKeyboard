     "msgstr \"\353\251\224\353\211\264\354\227\220\354\204\234 \354\235\264 \353\217\231\354\236\221\354\227\220 \354\223\260\353\212\224 \355\202\244\354\236\205\353\213\210\353\213\244. \354\232\264\354\240\204 \354\244\221\354\227\220\353\212\224 \354\225\204\353\254\264 \354\235\274\353\217\204 \355\225\230\354\247\200 \354\225\212\354\234\274\353\257\200\353\241\234 \354\243\274\355\226\211 \355\202\244\354\231\200 \352\260\231\354\225\204\353\217\204 \353\220\251\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"The key for this while driving: Extra Options' own, pressed on the controller button its ini gives it. It does nothing in the menus, so it can be a menu key too.\"\n"
     "msgstr \"\354\232\264\354\240\204 \354\244\221 \354\235\264 \353\217\231\354\236\221\354\227\220 \354\223\260\353\212\224 \355\202\244\354\236\205\353\213\210\353\213\244. Extra Options \354\236\220\354\262\264 \352\270\260\353\212\245\354\234\274\353\241\234, \352\267\270 ini\354\227\220 \354\247\200\354\240\225\353\220\234 \354\273\250\355\212\270\353\241\244\353\237\254 \353\262\204\355\212\274\354\235\204 \353\210\204\353\246\205\353\213\210\353\213\244. \353\251\224\353\211\264\354\227\220\354\204\234\353\212\224 \354\225\204\353\254\264 \354\235\274\353\217\204 \355\225\230\354\247\200 \354\225\212\354\234\274\353\257\200\353\241\234 \353\251\224\353\211\264 \355\202\244\354\231\200 \352\260\231\354\225\204\353\217\204 \353\220\251\353\213\210\353\213\244.\"\n"
