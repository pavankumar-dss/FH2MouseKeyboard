     "msgstr \"\320\225\320\267\320\264\320\270\321\202\320\265 \320\275\320\260 \320\272\320\273\320\260\320\262\320\270\320\260\321\202\321\203\321\200\320\265, \320\275\320\260\320\262\320\276\320\264\320\270\321\202\320\265 \320\270 \321\211\321\221\320\273\320\272\320\260\320\271\321\202\320\265 \320\262 \320\274\320\265\320\275\321\216, \320\277\320\265\321\200\320\265\321\202\320\260\321\201\320\272\320\270\320\262\320\260\320\271\321\202\320\265 \320\272\320\260\321\200\321\202\321\203, \320\262\321\200\320\260\321\211\320\260\320\271\321\202\320\265 \320\272\320\260\320\274\320\265\321\200\321\203 \320\262 \320\263\320\260\321\200\320\260\320\266\320\265, \321\200\320\260\320\267\320\274\320\265\321\211\320\260\320\271\321\202\320\265 \320\275\320\260\320\272\320\273\320\265\320\271\320\272\320\270 \321\201 \320\272\320\273\320\260\320\262\320\270\320\260\321\202\321\203\321\200\321\213 \320\270 \321\203\320\277\321\200\320\260\320\262\320\273\321\217\320\271\321\202\320\265 \320\272\320\260\320\274\320\265\321\200\320\276\320\271 \321\204\320\276\321\202\320\276\321\200\320\265\320\266\320\270\320\274\320\260, \320\270 \320\262\321\201\321\221 \321\215\321\202\320\276 \320\261\320\265\320\267 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200\320\260.\"\n"
     "\n"
     "msgid \"Keyboard controls\"\n"
     "msgstr \"\320\243\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265 \321\201 \320\272\320\273\320\260\320\262\320\270\320\260\321\202\321\203\321\200\321\213\"\n"
     "\n"
     "msgid \"Drive with the keyboard and move around the menus with it. The rows below set the keys.\"\n"
     "msgstr \"\320\243\320\277\321\200\320\260\320\262\320\273\321\217\320\271\321\202\320\265 \320\274\320\260\321\210\320\270\320\275\320\276\320\271 \321\201 \320\272\320\273\320\260\320\262\320\270\320\260\321\202\321\203\321\200\321\213 \320\270 \320\277\320\265\321\200\320\265\320\274\320\265\321\211\320\260\320\271\321\202\320\265\321\201\321\214 \320\265\321\216 \320\277\320\276 \320\274\320\265\320\275\321\216. \320\241\321\202\321\200\320\276\320\272\320\270 \320\275\320\270\320\266\320\265 \320\267\320\260\320\264\320\260\321\216\321\202 \320\272\320\273\320\260\320\262\320\270\321\210\320\270.\"\n"
     "\n"
     "msgid \"Keyboard icons\"\n"
