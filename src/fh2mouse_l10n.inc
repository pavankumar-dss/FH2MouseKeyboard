     "msgid \"FH2 ANNA's key while driving, pressing the controller's d-pad for it. The open key is ANNA's whenever you drive, the others only while ANNA's menu is open: a driving key on the same key waits till then.\"\n"
     "msgstr \"\354\232\264\354\240\204 \354\244\221 FH2 ANNA\354\235\230 \355\202\244\353\241\234, \354\273\250\355\212\270\353\241\244\353\237\254\354\235\230 \353\260\251\355\226\245 \355\214\250\353\223\234\353\245\274 \353\214\200\354\213\240 \353\210\204\353\246\205\353\213\210\353\213\244. \354\227\264\352\270\260 \355\202\244\353\212\224 \354\232\264\354\240\204 \354\244\221 \355\225\255\354\203\201 ANNA\352\260\200 \354\202\254\354\232\251\355\225\230\352\263\240, \353\202\230\353\250\270\354\247\200\353\212\224 ANNA \353\251\224\353\211\264\352\260\200 \354\227\264\353\240\244 \354\236\210\354\235\204 \353\225\214\353\247\214 \354\202\254\354\232\251\355\225\251\353\213\210\353\213\244. \352\260\231\354\235\200 \355\202\244\354\235\230 \354\243\274\355\226\211 \354\241\260\354\236\221\354\235\200 \352\267\270\353\217\231\354\225\210 \354\236\221\353\217\231\355\225\230\354\247\200 \354\225\212\354\212\265\353\213\210\353\213\244.\"\n"
     "\n"
     "msgid \"ANNA Drone Mode's key while flying the drone. While it flies only its keys (and the radio's) count, so it can be a driving or menu key too.\"\n"
     "msgstr \"ANNA Drone Mode\353\241\234 \353\223\234\353\241\240\354\235\204 \354\241\260\354\242\205\355\225\230\353\212\224 \353\217\231\354\225\210\354\235\230 \355\202\244\354\236\205\353\213\210\353\213\244. \353\271\204\355\226\211 \354\244\221\354\227\220\353\212\224 \353\223\234\353\241\240 \355\202\244(\354\231\200 \353\235\274\353\224\224\354\230\244 \355\202\244)\353\247\214 \354\236\221\353\217\231\355\225\230\353\257\200\353\241\234 \354\243\274\355\226\211\354\235\264\353\202\230 \353\251\224\353\211\264 \355\202\244\354\231\200 \352\260\231\354\225\204\353\217\204 \353\220\251\353\213\210\353\213\244.\"\n"
     "\n"
