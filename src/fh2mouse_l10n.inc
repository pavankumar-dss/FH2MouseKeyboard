     "msgstr \"\320\222\321\213\320\261\320\276\321\200 \320\275\320\260\320\262\320\265\320\264\320\265\320\275\320\270\320\265\320\274 \320\274\321\213\321\210\320\270\"\n"
     "\n"
     "msgid \"Moving the mouse over a button, list row or slider selects it. Off, only a click does.\"\n"
     "msgstr \"\320\235\320\260\320\262\320\265\320\264\320\265\320\275\320\270\320\265 \320\274\321\213\321\210\320\270 \320\275\320\260 \320\272\320\275\320\276\320\277\320\272\321\203, \321\201\321\202\321\200\320\276\320\272\321\203 \321\201\320\277\320\270\321\201\320\272\320\260 \320\270\320\273\320\270 \320\277\320\276\320\273\320\267\321\203\320\275\320\276\320\272 \320\262\321\213\320\261\320\270\321\200\320\260\320\265\321\202 \320\270\321\205. \320\225\321\201\320\273\320\270 \320\262\321\213\320\272\320\273\321\216\321\207\320\265\320\275\320\276, \320\262\321\213\320\261\320\270\321\200\320\260\320\265\321\202 \321\202\320\276\320\273\321\214\320\272\320\276 \321\211\320\265\320\273\321\207\320\276\320\272.\"\n"
     "\n"
     "msgid \"Mouse free look\"\n"
     "msgstr \"\320\241\320\262\320\276\320\261\320\276\320\264\320\275\321\213\320\271 \320\276\320\261\320\267\320\276\321\200 \320\274\321\213\321\210\321\214\321\216\"\n"
     "\n"
     "msgid \"While driving, moving the mouse looks around. The cursor stays in the game's window: Alt+Tab to leave it.\"\n"
     "msgstr \"\320\222\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213 \320\264\320\262\320\270\320\266\320\265\320\275\320\270\320\265 \320\274\321\213\321\210\320\270 \320\277\320\276\320\267\320\262\320\276\320\273\321\217\320\265\321\202 \320\276\321\201\320\274\320\260\321\202\321\200\320\270\320\262\320\260\321\202\321\214\321\201\321\217. \320\232\321\203\321\200\321\201\320\276\321\200 \320\276\321\201\321\202\320\260\321\221\321\202\321\201\321\217 \320\262 \320\276\320\272\320\275\320\265 \320\270\320\263\321\200\321\213: Alt+Tab, \321\207\321\202\320\276\320\261\321\213 \320\262\321\213\320\271\321\202\320\270 \320\270\320\267 \320\275\320\265\320\263\320\276.\"\n"
     "\n"
     "msgid \"Mouse free look sensitivity\"\n"
     "msgstr \"\320\247\321\203\320\262\321\201\321\202\320\262\320\270\321\202\320\265\320\273\321\214\320\275\320\276\321\201\321\202\321\214 \320\276\320\261\320\267\320\276\321\200\320\260 \320\274\321\213\321\210\321\214\321\216\"\n"
     "\n"
     "msgid \"How far the camera turns for the mouse's movement while you look around. 50 is the usual, 100 twice as far, 0 not at all.\"\n"
     "msgstr \"\320\235\320\260\321\201\320\272\320\276\320\273\321\214\320\272\320\276 \320\277\320\276\320\262\320\276\321\200\320\260\321\207\320\270\320\262\320\260\320\265\321\202\321\201\321\217 \320\272\320\260\320\274\320\265\321\200\320\260 \320\276\321\202 \320\264\320\262\320\270\320\266\320\265\320\275\320\270\321\217 \320\274\321\213\321\210\320\270 \320\277\321\200\320\270 \320\276\321\201\320\274\320\276\321\202\321\200\320\265. 50 \320\276\320\261\321\213\321\207\320\275\320\276, 100 \320\262\320\264\320\262\320\276\320\265 \321\201\320\270\320\273\321\214\320\275\320\265\320\265, 0 \321\201\320\276\320\262\321\201\320\265\320\274 \320\275\320\265\321\202.\"\n"
     "\n"
     "msgid \"Keyboard preset\"\n"
     "msgstr \"\320\240\320\260\321\201\320\272\320\273\320\260\320\264\320\272\320\260 \320\272\320\273\320\260\320\262\320\270\321\210\"\n"
     "\n"
     "msgid \"Sets every key below at once. WS drive, arrow steer is the mod's own layout; AZERTY and QWERTZ put the keys where WASD's are on those keyboards. Changing a key makes it Custom.\"\n"
     "msgstr \"\320\227\320\260\320\264\320\260\321\221\321\202 \321\201\321\200\320\260\320\267\321\203 \320\262\321\201\320\265 \320\272\320\273\320\260\320\262\320\270\321\210\320\270 \320\275\320\270\320\266\320\265. \302\253WS \320\264\320\273\321\217 \320\265\320\267\320\264\321\213, \321\201\321\202\321\200\320\265\320\273\320\272\320\270 \320\264\320\273\321\217 \321\200\321\203\320\273\321\217\302\273 \342\200\224 \321\201\320\276\320\261\321\201\321\202\320\262\320\265\320\275\320\275\320\260\321\217 \321\200\320\260\321\201\320\272\320\273\320\260\320\264\320\272\320\260 \320\274\320\276\320\264\320\260; AZERTY \320\270 QWERTZ \321\201\321\202\320\260\320\262\321\217\321\202 \320\272\320\273\320\260\320\262\320\270\321\210\320\270 \321\202\321\203\320\264\320\260, \320\263\320\264\320\265 \320\275\320\260 \321\215\321\202\320\270\321\205 \320\272\320\273\320\260\320\262\320\270\320\260\321\202\321\203\321\200\320\260\321\205 \320\275\320\260\321\205\320\276\320\264\321\217\321\202\321\201\321\217 WASD. \320\237\321\200\320\270 \320\270\320\267\320\274\320\265\320\275\320\265\320\275\320\270\320\270 \320\272\320\273\320\260\320\262\320\270\321\210\320\270 \320\262\321\213\320\261\320\270\321\200\320\260\320\265\321\202\321\201\321\217 \302\253\320\241\320\262\320\276\320\271\302\273.\"\n"
     "\n"
